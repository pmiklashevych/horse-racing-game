{
  "name": "horse-racing-game",
  "version": "1.0.1",
  "private": true,
  "description": "Horse racing simulation SPA built with Vue 3, Vite, and TypeScript.",
  "license": "MIT",
  "author": "Pavlo Miklashevych",
  "keywords": [
    "vue",
    "vite",
    "typescript",
    "pinia",
    "spa",
    "game",
    "horse-racing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pmiklashevych/horse-racing-game.git"
  },
  "bugs": {
    "url": "https://github.com/pmiklashevych/horse-racing-game/issues"
  },
  "homepage": "https://github.com/pmiklashevych/horse-racing-game#readme",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "check:full": "pnpm run check && pnpm run test:e2e",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/vue": "^10.39.0",
    "@vercel/speed-insights": "^1.3.1",
    "@vueuse/core": "^14.2.1",
    "animejs": "^4.3.6",
    "pinia": "^3.0.4",
    "vue": "^3.5.28",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
